# Public client configuration, never credentials. Release builds require a public HTTPS origin.
EXPO_PUBLIC_API_URL=https://api.example.invalid
# Optional public geocoder; typed address queries are sent to this service.
EXPO_PUBLIC_PLACES_API_URL=https://photon.komoot.io/api
# Test-data form population requires __DEV__ as well as this explicit opt-in.
EXPO_PUBLIC_ENABLE_PREVIEW=false

# Read-only browser visual harness. Ignored in production and on native platforms.
EXPO_PUBLIC_DESIGN_PREVIEW=false
